# Copy to .env and fill in. Never commit .env.

# LLM provider: "anthropic" or "openai_compatible" (Groq, OpenRouter, Ollama)
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI-compatible (open-source models)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# API
DATABASE_PATH=api/medtech.db
TZ=Asia/Tashkent

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
